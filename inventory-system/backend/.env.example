# Copy to .env and replace the values with your delivery credentials.
TEXTBEE_API_KEY=

# Gmail App Password (not your regular Gmail password). Keep this file local.
SMTP_PASSWORD=
# Optional SMTP/recipient overrides. Gmail SSL defaults are already configured.
# SMTP_USERNAME=you@example.com
# ALERT_EMAIL_TO=recipient@example.com
# CRITICAL_ALERT_REMINDER_SECONDS=600
# WARNING_ALERT_REMINDER_SECONDS=1800
